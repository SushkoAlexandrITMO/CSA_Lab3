.text 
_start: 
    @p input_addr a!
    lit 0 \В дата-стек загрузили 0 (iq)

read_loop: 
    @ \Грузим из mem[80] символ 
    dup \Дублируем значение в стек (множим его) 

    @p newline xor \Загрузили '\n' и проверили он ли это 

    if reverse_start \Если да, то строка кончилась 

    >r \Загрузили символ в rStack

    lit 1 + \Если нет, то увеличиваем длинну строки на 1 
    
    read_loop ; \Считываем следующий 

reverse_start: 
    drop \Сносим '\n' \dStack = [5 (len)], rStack = [111:108:108:101:104] 
    dup \[5, 5] 
    lit 0 b! !b \[5] 
    lit 1 a! 

reverse_loop: 
    dup if end \ если длина 0 -> конец 
    !p lenght \ сохранили length 

    r> \ достали символ из rStack 
    !+ \ mem[A]=символ; A++ 
    @p lenght lit -1 + \ length-- 
    
    reverse_loop ; 

.org 200
end: 
    lit 1 + b! 
    @p zatichka !b
    halt \Оканчиваем цирк