.data
.org 00
string:          .byte '________________________________'

.org 32
input_addr:      .word  0x80
output_addr:     .word  0x84
newline:         .word  0x0A

.text

_start:
    @p input_addr a!
    @p output_addr b! \Загрузили адреса ввода-вывода

    lit 0             \В дата-стек загрузили 0 (iq)

read_loop:
    @                 \Грузим из mem[80] символ

    dup               \Дублируем значение в стек (множим его)
    @p newline xor    \Загрузили '\n' и проверили он ли это
    if reverse_start  \Если да, то строка кончилась

    over lit 1 +      \Если нет, то свапаем T и S, увеличиваем длинну строки на 1

    read_loop ;       \Считываем следующий

reverse_start:
    drop              \Сносим '\n'

reverse_loop:
    dup              \Дублируем значение в стек (множим его)
    if end           \Если длинна 0, то усё, строку вывели

    >r              \dStack[-1] -> rStack[]

    !b              \dStack[-1] -> mem[b]

    r>              \rStack[-1] -> dStack[]
    lit -1 +        \Уменьшили длинну строки на 1

    reverse_loop ;  \Выводим дальше

end:
    halt            \Оканчиваем цирк



