    @p newline xor    \Загрузили '\n' и проверили он ли это
    if reverse_start  \Если да, то строка кончилась
    >r                \Загрузили символ в rStack

    lit 1 +      \Если нет, то увеличиваем длинну строки на 1

    dup
    lit 0x20 xor
    if r_start

    read_loop ;       \Считываем следующий

reverse_start:
    drop              \Сносим '\n'
    \dStack = [5 (len)], rStack = [111:108:108:101:104]

r_start:
    lit 0 a!
    @p output_addr b!


reverse_loop:
    dup
    if end                \ если длина 0 -> конец dStack[5], rStack[111:108:108:101:104]

    r>                    \ достали символ из rStack

    dup
    !+                    \ mem[A]=символ; A++
    
    !b

    lit -1 +              \ length--

    reverse_loop ;

.org 200
end:
    lit 0x00
    !+
    lit 0x5f5f5f5f
    !+

    halt            \Оканчиваем цирк